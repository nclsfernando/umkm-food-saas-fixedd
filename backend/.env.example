NODE_ENV=development
PORT=4000
# Neon: preferred = pooled connection string (host contains -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon non-pooler URL for Prisma migrate (same as DATABASE_URL if not using pooler)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
JWT_SECRET="ganti-dengan-secret-minimal-32-karakter-acak"
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
